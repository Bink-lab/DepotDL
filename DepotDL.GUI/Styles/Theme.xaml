<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:DepotDL.GUI.Converters"
        xmlns:helpers="using:DepotDL.GUI.Helpers">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DepotDL.GUI/Styles/LucideIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
            <conv:InverseBoolConverter x:Key="InvBool"/>
            <conv:DepotStatusToColorConverter x:Key="StatusToColor"/>
            <conv:DepotStatusToTextConverter x:Key="StatusToText"/>
            <conv:PercentToWidthConverter x:Key="PctToWidth"/>
            <conv:StringEmptyToVisibilityConverter x:Key="EmptyToVis" ShowWhenEmpty="True"/>
            <conv:StringEmptyToVisibilityConverter x:Key="NotEmptyToVis" ShowWhenEmpty="False"/>
            <conv:EqualityToVisibilityConverter x:Key="EqToVis"/>
            <conv:EqualityToBoolConverter x:Key="EqToBool"/>
            <conv:SpecStatusToBrushConverter x:Key="SpecToColor"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AccentColor">#000000</Color>
                    <Color x:Key="BgCardColor">#E6FFFFFF</Color>
                    <Color x:Key="BorderColor">#26000000</Color>
                    <Color x:Key="BgPageColor">#D6FFFFFF</Color>

                    <SolidColorBrush x:Key="BgPage"          Color="#CCFFFFFF"/>
                    <SolidColorBrush x:Key="BgSidebar"       Color="#80F5F5F7"/>
                    <SolidColorBrush x:Key="BgCard"          Color="#E6FFFFFF"/>
                    <SolidColorBrush x:Key="BgInput"         Color="#FFF9F9FB"/>
                    <SolidColorBrush x:Key="Accent"          Color="#000000"/>
                    <SolidColorBrush x:Key="AccentDark"      Color="#333333"/>
                    <SolidColorBrush x:Key="AccentLight"     Color="#FFE6E6E6"/>
                    <SolidColorBrush x:Key="AccentSubtle"    Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="AccentVeryLight" Color="#FFF5F5F5"/>
                    <SolidColorBrush x:Key="TextH"           Color="#000000"/>
                    <SolidColorBrush x:Key="TextPrimary"     Color="#000000"/>
                    <SolidColorBrush x:Key="TextBody"        Color="#333333"/>
                    <SolidColorBrush x:Key="TextSecondary"   Color="#555555"/>
                    <SolidColorBrush x:Key="TextMuted"       Color="#888888"/>
                    <SolidColorBrush x:Key="Border"          Color="#26000000"/>
                    <SolidColorBrush x:Key="BorderFocus"     Color="#000000"/>
                    <SolidColorBrush x:Key="DlcBadgeBg"      Color="#FFEAEAEA"/>
                    <SolidColorBrush x:Key="DlcBadgeFg"      Color="#444444"/>
                    <SolidColorBrush x:Key="Success"         Color="#000000"/>
                    <SolidColorBrush x:Key="SuccessBg"       Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="SuccessLight"    Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="Error"           Color="#000000"/>
                    <SolidColorBrush x:Key="ErrorBg"         Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="ErrorLight"      Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="Warning"         Color="#333333"/>
                    <SolidColorBrush x:Key="WarningBg"       Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="BtnPrimaryFg"    Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BtnPillCheckedFg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckedCheckBg" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckedCheckBorder" Color="#000000"/>
                    <BoxShadows x:Key="ButtonShadow">0 3 14 0 #1A000000</BoxShadows>
                    <BoxShadows x:Key="SplashShadow">0 3 25 3 #1A000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AccentColor">#FFFFFF</Color>
                    <Color x:Key="BgCardColor">#CC1C1C1E</Color>
                    <Color x:Key="BorderColor">#33FFFFFF</Color>
                    <Color x:Key="BgPageColor">#B3050505</Color>

                    <SolidColorBrush x:Key="BgPage"          Color="#CC050505"/>
                    <SolidColorBrush x:Key="BgSidebar"       Color="#80121212"/>
                    <SolidColorBrush x:Key="BgCard"          Color="#CC1C1C1E"/>
                    <SolidColorBrush x:Key="BgInput"         Color="#FF121214"/>
                    <SolidColorBrush x:Key="Accent"          Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentDark"      Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="AccentLight"     Color="#2D2D30"/>
                    <SolidColorBrush x:Key="AccentSubtle"    Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="AccentVeryLight" Color="#121212"/>
                    <SolidColorBrush x:Key="TextH"           Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimary"     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextBody"        Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="TextSecondary"   Color="#A3A3A3"/>
                    <SolidColorBrush x:Key="TextMuted"       Color="#737373"/>
                    <SolidColorBrush x:Key="Border"          Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="BorderFocus"     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="DlcBadgeBg"      Color="#2D2D30"/>
                    <SolidColorBrush x:Key="DlcBadgeFg"      Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="Success"         Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SuccessBg"       Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="SuccessLight"    Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="Error"           Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ErrorBg"         Color="#2D2D30"/>
                    <SolidColorBrush x:Key="ErrorLight"      Color="#2D2D30"/>
                    <SolidColorBrush x:Key="Warning"         Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="WarningBg"       Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="BtnPrimaryFg"    Color="#000000"/>
                    <SolidColorBrush x:Key="BtnPillCheckedFg" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckedCheckBg" Color="#2D2D30"/>
                    <SolidColorBrush x:Key="CheckedCheckBorder" Color="#FFFFFF"/>
                    <BoxShadows x:Key="ButtonShadow">0 0 0 0 #00000000</BoxShadows>
                    <BoxShadows x:Key="SplashShadow">0 0 0 0 #00000000</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="Scrim" Color="#000000"/>

            <!-- ══ ScrollBar ════════════════════════════════════════════════════ -->
            <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="6"/>
                <Setter Property="MinWidth" Value="6"/>
                <Setter Property="AllowAutoHide" Value="False"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton" IsVisible="False" Focusable="False"/>
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton" IsVisible="False" Focusable="False"/>
                                </Track.IncreaseButton>
                                <Thumb Name="PART_Thumb" Background="{DynamicResource Border}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3"
                                                    Background="{TemplateBinding Background}"
                                                    Margin="1,2">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Thumb#PART_Thumb">
                    <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
                </Style>
            </ControlTheme>

            <!-- ══ CheckBox ════════════════════════════════════════════════════ -->
            <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="17" Height="17">
                                <Border Name="boxBorder"
                                        CornerRadius="4"
                                        BorderThickness="1.5"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}">
                                    <Border.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                                <Path Name="tick"
                                      Data="{StaticResource LucideCheck}"
                                      Margin="3"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Fill="Transparent"
                                      Opacity="0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Path.Transitions>
                                </Path>
                            </Grid>
                            <ContentPresenter Name="PART_ContentPresenter" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^ /template/ Path#tick">
                    <Setter Property="RenderTransform" Value="scale(0,0)"/>
                </Style>
                <Style Selector="^:checked /template/ Border#boxBorder">
                    <Setter Property="Background" Value="{DynamicResource CheckedCheckBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CheckedCheckBorder}"/>
                </Style>
                <Style Selector="^:checked /template/ Path#tick">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RenderTransform" Value="scale(1,1)"/>
                </Style>
                <Style Selector="^:pointerover:not(:checked) /template/ Border#boxBorder">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Style>
            </ControlTheme>

            <!-- ══ Slider ════════════════════════════════════════════════════ -->
            <ControlTheme x:Key="SliderThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Name="e"
                                 Width="18" Height="18"
                                 Fill="{DynamicResource Accent}"
                                 Stroke="White"
                                 StrokeThickness="2.5">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Fill" Duration="0:0:0.1"/>
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Ellipse#e">
                    <Setter Property="Fill" Value="{DynamicResource AccentDark}"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="Slider">
                        <DataValidationErrors>
                            <Grid VerticalAlignment="Center" Height="20">
                                <Track Name="PART_Track"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}"
                                       Orientation="{TemplateBinding Orientation}">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2"
                                                            Background="{DynamicResource Accent}"
                                                            VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseButton>
                                    <Track.Thumb>
                                        <Thumb Name="PART_Thumb" Theme="{StaticResource SliderThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2"
                                                            Background="{DynamicResource Border}"
                                                            VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseButton>
                                </Track>
                            </Grid>
                        </DataValidationErrors>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ══ Button ControlThemes ════════════════════════════════════════ -->
            <ControlTheme x:Key="BtnPrimary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryFg}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                BoxShadow="{DynamicResource ButtonShadow}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bd">
                    <Setter Property="Background" Value="{DynamicResource AccentDark}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#bd">
                    <Setter Property="RenderTransform" Value="scale(0.97)"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.4"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="BtnSecondary" TargetType="Button">
                <Setter Property="Background" Value="#00000000"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bd">
                    <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#bd">
                    <Setter Property="RenderTransform" Value="scale(0.97)"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.4"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="BtnDanger" TargetType="Button">
                <Setter Property="Background" Value="#00000000"/>
                <Setter Property="Foreground" Value="{DynamicResource Error}"/>
                <Setter Property="BorderBrush" Value="#E3A9B5"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bd">
                    <Setter Property="Background" Value="{DynamicResource ErrorBg}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#bd">
                    <Setter Property="RenderTransform" Value="scale(0.97)"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="BtnGhost" TargetType="Button">
                <Setter Property="Background" Value="#00000000"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bd">
                    <Setter Property="Background" Value="{DynamicResource Border}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#bd">
                    <Setter Property="RenderTransform" Value="scale(0.97)"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
                <Setter Property="Background" Value="#00000000"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bd">
                    <Setter Property="Background" Value="{DynamicResource Border}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#bd">
                    <Setter Property="RenderTransform" Value="scale(0.97)"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.4"/>
                </Style>
            </ControlTheme>

            <!-- ══ BtnPill (ToggleButton) ════════════════════════════════════ -->
            <ControlTheme x:Key="BtnPill" TargetType="ToggleButton">
                <Setter Property="Background" Value="#00000000"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="11,5"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked /template/ Border#bd">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Style>
                <Style Selector="^:checked">
                    <Setter Property="Foreground" Value="{DynamicResource BtnPillCheckedFg}"/>
                </Style>
                <Style Selector="^:pointerover:not(:checked) /template/ Border#bd">
                    <Setter Property="Background" Value="{DynamicResource AccentVeryLight}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#bd">
                    <Setter Property="RenderTransform" Value="scale(0.96)"/>
                </Style>
            </ControlTheme>

        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#00000000"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#00000000"/>
    </Style>

    <!-- ══ TextBlock class-based styles ════════════════════════════════════ -->
    <Style Selector="TextBlock.TextH1">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
        <Setter Property="LineHeight" Value="36"/>
    </Style>
    <Style Selector="TextBlock.H1">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
        <Setter Property="LineHeight" Value="36"/>
    </Style>
    <Style Selector="TextBlock.TextH2">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
    </Style>
    <Style Selector="TextBlock.H2">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
    </Style>
    <Style Selector="TextBlock.TextH3">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
    </Style>
    <Style Selector="TextBlock.H3">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
    </Style>
    <Style Selector="TextBlock.BodyText">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style Selector="TextBlock.TextBodyStyle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="TextBlock.TextLabel">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style Selector="TextBlock.Label">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style Selector="TextBlock.Mono">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
    </Style>

    <!-- ══ Border class-based styles ════════════════════════════════════ -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style Selector="Border.CardFlat">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style Selector="Border.CardSmall">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style Selector="Border.Pill">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="Border.StatusPill">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style Selector="Border.DepotListItem">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style Selector="Border.DepotListItem:not(:pointerover)">
        <Setter Property="Background" Value="#00000000"/>
    </Style>

    <!-- ══ ScrollViewer global style ════════════════════════════════════ -->
    <Style Selector="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="helpers:SmoothScroll.IsEnabled" Value="True"/>
    </Style>

    <!-- ══ Separator ════════════════════════════════════════════════════ -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource Border}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- ══ TextBox ════════════════════════════════════════════════════ -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentLight}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}"/>
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
    </Style>

    <!-- ══ ComboBox ════════════════════════════════════════════════════ -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextH}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

</Styles>
